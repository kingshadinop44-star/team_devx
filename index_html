  <style>
    :root {
      --cyan: #00f5ff;
      --purple: #bf00ff;
      --blue: #0066ff;
      --dark: #040810;
      --dark2: #080f1e;
      --card: rgba(0,245,255,0.04);
      --glow-cyan: 0 0 20px rgba(0,245,255,0.5), 0 0 60px rgba(0,245,255,0.2);
      --glow-purple: 0 0 20px rgba(191,0,255,0.5), 0 0 60px rgba(191,0,255,0.2);
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    html { scroll-behavior: smooth; }

    body {
      background: var(--dark);
      color: #e0e8ff;
      font-family: 'Exo 2', sans-serif;
      overflow-x: hidden;
    }

    /* ── CANVAS BG ── */
    #bg-canvas {
      position: fixed; top: 0; left: 0;
      width: 100%; height: 100%;
      z-index: 0; pointer-events: none;
    }

    /* ── NAV ── */
    nav {
      position: fixed; top: 0; left: 0; right: 0;
      z-index: 100;
      display: flex; align-items: center; justify-content: space-between;
      padding: 18px 60px;
      background: rgba(4,8,16,0.8);
      backdrop-filter: blur(20px);
      border-bottom: 1px solid rgba(0,245,255,0.1);
    }
    .nav-logo {
      font-family: 'Rajdhani', sans-serif;
      font-size: 1.8rem; font-weight: 700;
      color: var(--cyan);
      text-shadow: var(--glow-cyan);
      letter-spacing: 3px;
    }
    .nav-logo span { color: var(--purple); }
    .nav-links { display: flex; gap: 40px; list-style: none; }
    .nav-links a {
      color: #8899bb; text-decoration: none;
      font-family: 'Rajdhani', sans-serif;
      font-size: 1rem; font-weight: 600; letter-spacing: 2px;
      text-transform: uppercase;
      transition: color .3s, text-shadow .3s;
    }
    .nav-links a:hover { color: var(--cyan); text-shadow: var(--glow-cyan); }
    .nav-cta {
      padding: 10px 28px;
      border: 1px solid var(--cyan);
      border-radius: 4px;
      color: var(--cyan) !important;
      text-shadow: none !important;
      transition: background .3s, box-shadow .3s !important;
    }
    .nav-cta:hover { background: rgba(0,245,255,0.1) !important; box-shadow: var(--glow-cyan) !important; }

    /* ── HERO ── */
    #hero {
      position: relative; z-index: 1;
      min-height: 100vh;
      display: flex; flex-direction: column;
      align-items: center; justify-content: center;
      text-align: center;
      padding: 120px 20px 80px;
    }
    .hero-badge {
      display: inline-block;
      font-family: 'Share Tech Mono', monospace;
      font-size: .75rem; letter-spacing: 4px;
      color: var(--cyan);
      border: 1px solid rgba(0,245,255,0.3);
      padding: 6px 20px; border-radius: 20px;
      margin-bottom: 30px;
      animation: fadeUp .8s ease both;
      background: rgba(0,245,255,0.05);
    }
    .hero-title {
      font-family: 'Rajdhani', sans-serif;
      font-size: clamp(3.5rem, 9vw, 8rem);
      font-weight: 700; line-height: .95;
      letter-spacing: -2px;
      animation: fadeUp .9s .1s ease both;
    }
    .hero-title .line1 {
      display: block; color: #fff;
      text-shadow: 0 0 80px rgba(0,102,255,0.4);
    }
    .hero-title .line2 {
      display: block;
      background: linear-gradient(90deg, var(--cyan), var(--purple));
      -webkit-background-clip: text; -webkit-text-fill-color: transparent;
      filter: drop-shadow(0 0 30px rgba(0,245,255,0.4));
    }
    .hero-sub {
      margin-top: 24px; max-width: 560px;
      font-size: 1.1rem; font-weight: 300;
      color: #6a80a8; line-height: 1.8;
      animation: fadeUp 1s .2s ease both;
    }
    .hero-buttons {
      display: flex; gap: 20px; margin-top: 44px; flex-wrap: wrap; justify-content: center;
      animation: fadeUp 1s .35s ease both;
    }
    .btn-primary {
      display: inline-flex; align-items: center; gap: 10px;
      padding: 16px 40px; border-radius: 6px;
      background: linear-gradient(135deg, var(--cyan), var(--blue));
      color: #000; font-family: 'Rajdhani', sans-serif;
      font-size: 1rem; font-weight: 700; letter-spacing: 2px;
      text-decoration: none; text-transform: uppercase;
      box-shadow: var(--glow-cyan);
      transition: transform .3s, box-shadow .3s;
    }
    .btn-primary:hover { transform: translateY(-3px); box-shadow: 0 0 40px rgba(0,245,255,0.7), 0 0 100px rgba(0,245,255,0.3); }
    .btn-secondary {
      display: inline-flex; align-items: center; gap: 10px;
      padding: 16px 40px; border-radius: 6px;
      border: 1px solid rgba(191,0,255,0.5);
      color: var(--purple); font-family: 'Rajdhani', sans-serif;
      font-size: 1rem; font-weight: 700; letter-spacing: 2px;
      text-decoration: none; text-transform: uppercase;
      transition: background .3s, box-shadow .3s, transform .3s;
    }
    .btn-secondary:hover { background: rgba(191,0,255,0.1); box-shadow: var(--glow-purple); transform: translateY(-3px); }

    /* ── STATS ── */
    #stats {
      position: relative; z-index: 1;
      padding: 20px 60px 80px;
      display: flex; justify-content: center; gap: 60px; flex-wrap: wrap;
    }
    .stat-card {
      text-align: center;
      animation: fadeUp 1s ease both;
    }
    .stat-num {
      font-family: 'Rajdhani', sans-serif;
      font-size: 3.8rem; font-weight: 700;
      background: linear-gradient(135deg, var(--cyan), var(--purple));
      -webkit-background-clip: text; -webkit-text-fill-color: transparent;
      filter: drop-shadow(0 0 20px rgba(0,245,255,0.5));
      line-height: 1;
    }
    .stat-label {
      font-family: 'Share Tech Mono', monospace;
      font-size: .75rem; letter-spacing: 3px;
      color: #4a6080; margin-top: 6px; text-transform: uppercase;
    }
    .stat-divider {
      width: 1px; background: linear-gradient(to bottom, transparent, rgba(0,245,255,0.3), transparent);
      align-self: stretch;
    }

    /* ── ORDER COUNTER ── */
    #counter-section {
      position: relative; z-index: 1;
      text-align: center;
      padding: 60px 20px;
    }
    .counter-box {
      display: inline-block;
      position: relative;
      padding: 50px 80px;
      border: 1px solid rgba(0,245,255,0.2);
      border-radius: 16px;
      background: rgba(0,245,255,0.03);
      backdrop-filter: blur(10px);
      overflow: hidden;
    }
    .counter-box::before {
      content: '';
      position: absolute; top: 0; left: 0; right: 0; height: 2px;
      background: linear-gradient(90deg, transparent, var(--cyan), transparent);
      animation: shimmer 3s infinite;
    }
    @keyframes shimmer { 0%,100% { opacity: .3 } 50% { opacity: 1 } }
    .counter-label {
      font-family: 'Share Tech Mono', monospace;
      font-size: .8rem; letter-spacing: 4px;
      color: #4a6080; margin-bottom: 16px; text-transform: uppercase;
    }
    .counter-number {
      font-family: 'Rajdhani', sans-serif;
      font-size: clamp(4rem, 12vw, 9rem);
      font-weight: 700; line-height: 1;
      background: linear-gradient(135deg, #fff 30%, var(--cyan));
      -webkit-background-clip: text; -webkit-text-fill-color: transparent;
      filter: drop-shadow(0 0 40px rgba(0,245,255,0.6));
    }
    .counter-sub {
      font-family: 'Rajdhani', sans-serif;
      font-size: 1.4rem; font-weight: 600;
      color: var(--cyan); letter-spacing: 3px; margin-top: 10px;
      text-transform: uppercase;
    }
    .counter-pulse {
      width: 10px; height: 10px; border-radius: 50%;
      background: var(--cyan); display: inline-block;
      margin-right: 10px; vertical-align: middle;
      animation: pulse 1.5s infinite;
      box-shadow: 0 0 10px var(--cyan);
    }
    @keyframes pulse { 0%,100% { opacity: 1; transform: scale(1) } 50% { opacity: .5; transform: scale(.7) } }

    /* ── SERVICES ── */
    section { position: relative; z-index: 1; }
    .section-header {
      text-align: center; padding: 80px 20px 50px;
    }
    .section-tag {
      font-family: 'Share Tech Mono', monospace;
      font-size: .75rem; letter-spacing: 4px;
      color: var(--cyan); text-transform: uppercase;
      margin-bottom: 16px;
    }
    .section-title {
      font-family: 'Rajdhani', sans-serif;
      font-size: clamp(2rem, 5vw, 3.5rem);
      font-weight: 700; color: #fff;
      line-height: 1.1;
    }
    .section-title span {
      background: linear-gradient(90deg, var(--cyan), var(--purple));
      -webkit-background-clip: text; -webkit-text-fill-color: transparent;
    }

    .services-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 24px; padding: 0 60px 80px; max-width: 1300px; margin: 0 auto;
    }
    .service-card {
      position: relative; overflow: hidden;
      padding: 36px 32px;
      border: 1px solid rgba(0,245,255,0.1);
      border-radius: 12px;
      background: var(--card);
      backdrop-filter: blur(10px);
      transition: border-color .3s, transform .3s, box-shadow .3s;
      cursor: default;
    }
    .service-card::after {
      content: ''; position: absolute;
      top: 0; left: 0; right: 0; bottom: 0;
      background: linear-gradient(135deg, rgba(0,245,255,0.05), transparent);
      opacity: 0; transition: opacity .3s;
    }
    .service-card:hover { border-color: rgba(0,245,255,0.4); transform: translateY(-6px); box-shadow: 0 20px 60px rgba(0,245,255,0.1); }
    .service-card:hover::after { opacity: 1; }
    .service-icon {
      font-size: 2.5rem; margin-bottom: 20px;
      filter: drop-shadow(0 0 10px rgba(0,245,255,0.4));
    }
    .service-name {
      font-family: 'Rajdhani', sans-serif;
      font-size: 1.3rem; font-weight: 700;
      color: #fff; letter-spacing: 1px; margin-bottom: 12px;
    }
    .service-desc {
      font-size: .9rem; color: #5a7090; line-height: 1.7;
    }
    .service-tag {
      display: inline-block; margin-top: 20px;
      font-family: 'Share Tech Mono', monospace;
      font-size: .65rem; letter-spacing: 2px;
      color: var(--cyan); border: 1px solid rgba(0,245,255,0.3);
      padding: 4px 12px; border-radius: 20px;
    }

    /* ── SKILLS / EXPERTISE ── */
    .skills-wrap {
      padding: 0 60px 80px; max-width: 1000px; margin: 0 auto;
    }
    .skill-row {
      display: flex; align-items: center; gap: 20px; margin-bottom: 24px;
    }
    .skill-name {
      font-family: 'Rajdhani', sans-serif;
      font-size: 1rem; font-weight: 600; letter-spacing: 2px;
      color: #8899bb; width: 160px; text-transform: uppercase;
      flex-shrink: 0;
    }
    .skill-bar {
      flex: 1; height: 6px; border-radius: 3px;
      background: rgba(255,255,255,0.05);
      overflow: hidden;
    }
    .skill-fill {
      height: 100%; border-radius: 3px;
      background: linear-gradient(90deg, var(--blue), var(--cyan));
      box-shadow: 0 0 12px rgba(0,245,255,0.4);
      width: 0; transition: width 1.5s ease;
    }
    .skill-pct {
      font-family: 'Share Tech Mono', monospace;
      font-size: .8rem; color: var(--cyan); width: 40px; text-align: right;
    }

    /* ── CONTACT ── */
    #contact {
      padding: 0 20px 100px;
      display: flex; flex-direction: column; align-items: center;
    }
    .contact-grid {
      display: flex; gap: 24px; flex-wrap: wrap; justify-content: center;
      max-width: 800px; width: 100%; margin-top: 10px;
    }
    .contact-card {
      flex: 1; min-width: 220px;
      display: flex; align-items: center; gap: 18px;
      padding: 28px 30px;
      border: 1px solid rgba(0,245,255,0.15);
      border-radius: 12px;
      background: rgba(0,245,255,0.03);
      text-decoration: none;
      transition: border-color .3s, transform .3s, box-shadow .3s;
    }
    .contact-card:hover { border-color: rgba(0,245,255,0.5); transform: translateY(-4px); box-shadow: var(--glow-cyan); }
    .contact-icon { font-size: 2rem; }
    .contact-info-label {
      font-family: 'Share Tech Mono', monospace;
      font-size: .65rem; letter-spacing: 3px; color: #4a6080;
      text-transform: uppercase; margin-bottom: 4px;
    }
    .contact-info-val {
      font-family: 'Rajdhani', sans-serif;
      font-size: 1.05rem; font-weight: 600; color: #e0e8ff;
    }

    /* ── FOOTER ── */
    footer {
      position: relative; z-index: 1;
      text-align: center; padding: 30px 20px 40px;
      border-top: 1px solid rgba(0,245,255,0.07);
      font-family: 'Share Tech Mono', monospace;
      font-size: .7rem; letter-spacing: 2px;
      color: #2a3a50;
    }
    footer span { color: var(--cyan); }

    /* ── ANIMATIONS ── */
    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(30px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    .reveal { opacity: 0; transform: translateY(40px); transition: opacity .8s ease, transform .8s ease; }
    .reveal.visible { opacity: 1; transform: translateY(0); }

    /* ── SCROLLBAR ── */
    ::-webkit-scrollbar { width: 6px; }
    ::-webkit-scrollbar-track { background: var(--dark); }
    ::-webkit-scrollbar-thumb { background: rgba(0,245,255,0.3); border-radius: 3px; }

    /* ── RESPONSIVE ── */
    @media (max-width: 768px) {
      nav { padding: 14px 24px; }
      .nav-links { display: none; }
      #stats { padding: 20px 20px 60px; gap: 30px; }
      .stat-divider { display: none; }
      .services-grid { padding: 0 20px 60px; }
      .skills-wrap { padding: 0 20px 60px; }
      .counter-box { padding: 40px 30px; }
    }

    /* ── TYPING cursor ── */
    .typed::after {
      content: '|'; animation: blink 1s step-end infinite;
      color: var(--cyan);
    }
    @keyframes blink { 50% { opacity: 0 } }
  </style>
</head>
